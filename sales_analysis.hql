/* 
   E-commerce Sales Analysis using Apache Hive
   Objective: Find the total revenue generated by each product category.
*/

-- 1. Create the schema (table structure)
CREATE TABLE IF NOT EXISTS sales (
    order_id INT,
    category STRING,
    price DOUBLE,
    order_date STRING
)
ROW FORMAT DELIMITED
FIELDS TERMINATED BY ',';

-- 2. Load the dataset from the local file system into the Hive table
LOAD DATA LOCAL INPATH 'sales_data.csv' OVERWRITE INTO TABLE sales;

-- 3. Execute the MapReduce data aggregation query
SELECT 
    category, 
    SUM(price) AS total_revenue
FROM 
    sales
GROUP BY 
    category
ORDER BY 
    total_revenue DESC;